+    # [0, 6, 7] it returns [0, 4, 6, 7, 6], and closing the tour adds the jump 6 -> 0).
+    # Insert the missing intermediate steps, and drop repeated entries.
+    walk = [tr_seq[0]]
+    for loc in tr_seq[1:]:
+        walk += hamming_movement(walk[-1], loc, bit_amount)
+    tr_seq = walk
